---
layout: null
sitemap: false
---
[
{%- for p in site.posts -%}
{%- assign c = site.data.categories | where: "slug", p.categories[0] | first -%}
{
  "title": {{ p.title | jsonify }},
  "url": {{ p.url | relative_url | jsonify }},
  "date": {{ p.date | date: "%-d %b %Y" | jsonify }},
  "category": {{ c.name | default: "" | jsonify }},
  "tags": {{ p.tags | jsonify }},
  "excerpt": {{ p.description | default: p.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }},
  "body": {{ p.content | strip_html | strip_newlines | normalize_whitespace | truncatewords: 400 | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
